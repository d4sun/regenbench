    "rows": [
      {
        "number": 1,
        "description": "INT and LONG opcodes use base 0 in all implementations except pickletools, which uses an explicit base of 10",
        "found_manually": true,
        "found_by_fuzzing": true,
        "type": "Error",
        "differing_module": "pickletools",
        "security_impact": true,
        "python_issue": 126992,
        "status": "Fixed",
        "note": "Used in bug-bounty PoC: base-16 value like 0x1337 parses in pickle/_pickle but raises in pickletools; picklescan shows no malicious alerts while loading executes posix.system.",
        "critical_by_paper_rq2": true
      },
      {
        "number": 2,
        "description": "All newline-terminated opcode arguments are ended early by null bytes in _pickle, but throw errors in the other implementations",
        "found_manually": true,
        "found_by_fuzzing": true,
        "type": "Error",
        "differing_module": "_pickle",
        "security_impact": true,
        "python_issue": 126996,
        "status": "Open",
        "critical_by_paper_rq2": true
      },
      {
        "number": 3,
        "description": "Lack of pickletools encoding support leads to invalid transformation of bytes to strings for some opcodes",
        "found_manually": true,
        "found_by_fuzzing": true,
        "type": "Error",
        "differing_module": "pickletools",
        "security_impact": true,
        "python_issue": 126997,
        "status": "Fixed",
        "critical_by_paper_rq2": true
      },
      {
        "number": 4,
        "description": "pickletools errors if there's any number of items left on the stack when reaching the STOP opcode, while other implementations do not",
        "found_manually": true,
        "found_by_fuzzing": true,
        "type": "Error",
        "differing_module": "pickletools",
